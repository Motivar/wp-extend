{
    "name": "motivar/wp-self-test",
    "description": "Manifest-driven self-test suite for WordPress plugins: register a manifest of cases from your plugin folder and run them from wp-admin, WP-CLI, the Abilities API, a pre-push hook and CI.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://gitlab.motivar.io/tools/wp-selft-test",
    "authors": [
        {
            "name": "Motivar",
            "email": "info@motivar.io"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Motivar\\SelfTest\\": "src/"
        }
    },
    "bin": [
        "bin/run.php",
        "bin/install-hooks"
    ]
}
