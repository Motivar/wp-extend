{
    "name": "gnnpls/wp-self-test",
    "description": "Manifest-driven self-test suite for WordPress plugins: register a manifest of cases from your plugin folder and run them from wp-admin, WP-CLI, the Abilities API and a pre-push hook.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "self-test",
        "testing",
        "wp-cli",
        "rest-api",
        "abilities-api",
        "pre-push"
    ],
    "homepage": "https://gnnpls.com",
    "authors": [
        {
            "name": "Nikos Giannopoulos",
            "email": "nikos@gnnpls.com",
            "homepage": "https://gnnpls.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gnnpls/wp-self-test/issues",
        "source": "https://github.com/gnnpls/wp-self-test",
        "email": "nikos@gnnpls.com"
    },
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gnnpls\\SelfTest\\": "src/"
        }
    },
    "bin": [
        "bin/run.php",
        "bin/install-hooks"
    ]
}
