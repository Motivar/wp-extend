{
    "name": "gnnpls/wp-kit",
    "description": "Declare a WordPress feature once and expose it as a REST route, a WP-CLI command and a WordPress Ability from the same definition.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "rest-api",
        "wp-cli",
        "abilities-api",
        "validation",
        "library"
    ],
    "homepage": "https://gnnpls.com",
    "authors": [
        {
            "name": "Nikos Giannopoulos",
            "email": "nikos@gnnpls.com",
            "homepage": "https://gnnpls.com"
        }
    ],
    "support": {
        "issues": "https://github.com/gnnpls/wp-kit/issues",
        "source": "https://github.com/gnnpls/wp-kit",
        "email": "nikos@gnnpls.com"
    },
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gnnpls\\WP\\": "src/"
        }
    }
}
