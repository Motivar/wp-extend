{
    "name": "mammothwp/wp-self-test",
    "description": "Manifest-driven self-test suite for WordPress plugins: register a manifest of cases from your plugin folder and run them from wp-admin, WP-CLI, the Abilities API and a pre-push hook.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "self-test",
        "testing",
        "wp-cli",
        "rest-api",
        "abilities-api",
        "pre-push"
    ],
    "homepage": "https://mammothwp.com",
    "authors": [
        {
            "name": "Mammoth WP",
            "email": "info@mammothwp.com",
            "homepage": "https://mammothwp.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mammothwp/wp-self-test/issues",
        "source": "https://github.com/mammothwp/wp-self-test",
        "email": "info@mammothwp.com"
    },
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "bootstrap.php",
            "compat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MammothWP\\SelfTest\\": "src/",
            "MammothWP\\SelfTest\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/run.php",
        "bin/install-hooks"
    ],
    "replace": {
        "gnnpls/wp-self-test": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/wp-cli-stubs": "^2.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "lint": "git ls-files -z -- \"*.php\" | xargs -0 -n1 php -l >/dev/null"
    }
}
