#!/usr/bin/env bash
#
# Generic pre-push hook shipped by mammothwp/wp-self-test.
#
# Installed into a consumer repository by bin/install-hooks, which writes a
# two-line shim at .githooks/pre-push that execs this file, and points
# core.hooksPath at that directory. Git runs the shim on every `git push`
# with the remote name and URL as arguments and the pushed refs on stdin.
#
# What it does, in order:
#   1. Skips silently when the push only deletes refs or only pushes tags.
#   2. `php -l` on every tracked PHP file — blocks on a syntax error.
#   3. Runs the consumer's test command — blocks when it fails:
#        - `composer run-script test` when composer.json defines a "test" script,
#        - otherwise tests/pre-push.sh when it exists,
#        - otherwise warns that no test command is configured and passes.
#   4. Browser layer (only when package.json depends on @mammothwp/wp-self-test-e2e):
#      runs `wp mmwp self-test run --layer=browser` through DDEV (or through
#      MMWP_SELF_TEST_BROWSER_CMD for another site) — blocks when a browser
#      check fails; when DDEV is stopped or Node is missing it warns and skips,
#      like a stopped DDEV is treated everywhere else. MMWP_SELF_TEST_BROWSER=0
#      turns the step off.
#
# `git push --no-verify` bypasses any client hook, so treat that as a deliberate decision.
#
# @package MammothWP\SelfTest
# @since   0.1.0

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Nothing to test when only deleting refs or pushing tags.
ZERO="0000000000000000000000000000000000000000"
PUSHING_CODE=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
    case "$local_ref" in
        refs/tags/*) continue ;;
    esac
    PUSHING_CODE=1
done
if [ "$PUSHING_CODE" -eq 0 ]; then
    exit 0
fi

# 2. Syntax check.
echo "[pre-push] Syntax-checking tracked PHP files..."
LINT_LOG="$(mktemp)"
LINT_FAILED=0
while IFS= read -r -d '' file; do
    if ! php -l "$file" >"$LINT_LOG" 2>&1; then
        echo "[pre-push] Syntax error in $file:"
        cat "$LINT_LOG"
        LINT_FAILED=1
    fi
done < <(git ls-files -z -- '*.php')
rm -f "$LINT_LOG"

if [ "$LINT_FAILED" -ne 0 ]; then
    echo "[pre-push] Aborting push: fix the syntax error(s) above."
    exit 1
fi
echo "[pre-push] PHP syntax OK."

# 3. The consumer's test command.
has_composer_test() {
    [ -f composer.json ] && php -r '$j=json_decode(file_get_contents("composer.json"),true); exit(isset($j["scripts"]["test"])?0:1);'
}

# 4. Browser layer: Playwright admin smoke tests, when the plugin opted in.
# Prints a warning and returns 0 when the site or Node cannot be reached.
run_browser_layer() {
    [ "${MMWP_SELF_TEST_BROWSER:-1}" = "0" ] && return 0
    [ -f package.json ] && grep -q '@mammothwp/wp-self-test-e2e' package.json || return 0

    local cmd="${MMWP_SELF_TEST_BROWSER_CMD:-}"

    if [ -z "$cmd" ]; then
        if [ ! -f .ddev/config.yaml ]; then
            echo "[pre-push] WARNING: browser layer skipped: no .ddev/config.yaml and MMWP_SELF_TEST_BROWSER_CMD is not set."
            return 0
        fi
        if ! command -v ddev >/dev/null 2>&1 || ! ddev describe >/dev/null 2>&1; then
            echo "[pre-push] WARNING: browser layer skipped: DDEV is not running (ddev start)."
            return 0
        fi
        if ! ddev exec node --version >/dev/null 2>&1; then
            echo "[pre-push] WARNING: browser layer skipped: Node.js is not available in the DDEV web container (set nodejs_version in .ddev/config.yaml)."
            return 0
        fi
        cmd="ddev wp mmwp self-test run --layer=browser"
    fi

    echo "[pre-push] Running the browser layer (\`$cmd\`)..."
    if ! bash -c "$cmd"; then
        echo "[pre-push] Aborting push: a browser check failed. Fix it, or run with --no-verify if you are certain this push should bypass tests."
        return 1
    fi
    return 0
}

if has_composer_test; then
    echo "[pre-push] Running \`composer run-script test\`..."
    if ! composer run-script test; then
        echo "[pre-push] Aborting push: the test command failed. Fix the failing test(s) above, or run with --no-verify if you are certain this push should bypass tests."
        exit 1
    fi
elif [ -x tests/pre-push.sh ]; then
    echo "[pre-push] Running tests/pre-push.sh..."
    if ! bash tests/pre-push.sh; then
        echo "[pre-push] Aborting push: tests/pre-push.sh failed."
        exit 1
    fi
else
    echo "[pre-push] No test command configured (composer.json scripts.test or tests/pre-push.sh) — skipping tests (not blocking the push)."
fi

run_browser_layer || exit 1

echo "[pre-push] All tests passed."
exit 0
