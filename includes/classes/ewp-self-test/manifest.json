{
    "$comment": "Single source of truth for the Extend WP self-test suite, registered with the gnnpls/wp-self-test package (lib/gnnpls/wp-self-test). Every entry is one feature exercised through each surface it is exposed on (REST, WP-CLI, Abilities API). Consumed identically by Tools > Self-test (WP_DEBUG only), `wp mwp self-test`, the mwp-self-test/* abilities, the pre-push hook and GitLab CI (both via `composer test`). Add an entry here whenever a new REST route, CLI command or ability is added; tests/test-self-test-manifest-test.php fails when a generated surface is not covered.",
    "version": 1,
    "cases": [
        {
            "id": "content-crud",
            "label": "Custom content CRUD (generic content types)",
            "category": "content",
            "layers": [
                "rest",
                "cli",
                "ability"
            ],
            "class": "EWP\\SelfTest\\Cases\\Content_Crud_Case",
            "requires": [],
            "args": {
                "namespace": "ewp"
            },
            "covers": {
                "rest": [
                    "{prefix}/{type}",
                    "{prefix}/{type}/{id}",
                    "{prefix}/{type}/create",
                    "{prefix}/{type}/update/{id}",
                    "{prefix}/{type}/delete"
                ],
                "cli": [
                    "ewp content types",
                    "ewp content list",
                    "ewp content get",
                    "ewp content create",
                    "ewp content update",
                    "ewp content delete"
                ],
                "ability": [
                    "ewp-content/list-content-types",
                    "ewp-content/list-items",
                    "ewp-content/get-item",
                    "ewp-content/create-item",
                    "ewp-content/update-item",
                    "ewp-content/delete-item"
                ]
            }
        },
        {
