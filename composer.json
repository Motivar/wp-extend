{
    "name": "motivar/extend-wp",
    "version": "1.5.1",
    "description": " Extend WordPress with custom functionality",
    "license": "GPL-2.0-or-later",
    "keywords": ["custom-fields", "advanced-custom-fields", "wordpress"],
    "homepage": "https://motivar.io/",
    "type": "wordpress-plugin",
    "authors": [{
        "name": "Motivar",
        "email": "info@motivar.cio"
    }],
    "config": {
        "vendor-dir": "lib",
        "optimize-autoloader": true,
        "apcu-autoloader": true,
        "preferred-install": {
            "gnnpls/*": "dist",
            "*": "auto"
        }
    },
    "support": {
        "issues": "https://motivar.io/"
    },
    "require": {
        "gnnpls/wp-kit": "dev-main",
        "gnnpls/wp-self-test": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "EWP\\": "includes/classes/"
        },
        "files": [
            "includes/functions/init.php",
            "includes/classes/class-encryption.php"
        ]
    },
    "scripts": {
        "test": "bash tests/run-tests.sh",
        "post-install-cmd": [
            "@php lib/gnnpls/wp-self-test/bin/install-hooks"
        ]
    }
}
