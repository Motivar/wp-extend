#!/usr/bin/env bash
#
# Pre-push hook for motivar/extend-wp.
#
# Runs `php -l` on every tracked PHP file and the PHPUnit suite (see
# tests/) inside the project's DDEV container before letting `git push`
# proceed. Blocks the push on a syntax error or a failing test; skips
# (with a warning, not a block) when the local dev environment simply
# isn't available, since that's an infra gap, not a code problem.
#
# Installed via: git config core.hooksPath .githooks
# (done automatically by `composer install` at the plugin root — see the
# post-install-cmd script in composer.json — or run it yourself once.)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] Syntax-checking tracked PHP files..."
LINT_FAILED=0
while IFS= read -r -d '' file; do
    if ! php -l "$file" >/tmp/ewp-pre-push-lint.log 2>&1; then
        echo "[pre-push] Syntax error in $file:"
        cat /tmp/ewp-pre-push-lint.log
        LINT_FAILED=1
    fi
done < <(git ls-files -z -- '*.php')
rm -f /tmp/ewp-pre-push-lint.log

if [ "$LINT_FAILED" -ne 0 ]; then
    echo "[pre-push] Aborting push: fix the syntax error(s) above."
    exit 1
fi
echo "[pre-push] PHP syntax OK."

if ! command -v ddev >/dev/null 2>&1; then
    echo "[pre-push] ddev not found on PATH — skipping the PHPUnit suite (not blocking the push)."
    exit 0
fi

if ! ddev exec true >/dev/null 2>&1; then
    echo "[pre-push] DDEV project isn't running (\`ddev start\`) — skipping the PHPUnit suite (not blocking the push)."
    exit 0
fi

echo "[pre-push] Ensuring the test toolchain is installed..."
if [ ! -x "tests/vendor/bin/phpunit" ]; then
    ddev exec bash -c "cd wp-content/plugins/wp-extend/tests && composer install --no-interaction --prefer-dist" || {
        echo "[pre-push] Could not install the test toolchain (tests/composer.json) — skipping the PHPUnit suite (not blocking the push)."
        exit 0
    }
fi

echo "[pre-push] Ensuring the wp_extend_tests database exists..."
ddev exec mysql -h db -u db -pdb -e "SELECT 1;" wp_extend_tests >/dev/null 2>&1 || \
    ddev exec mysql -h db -u root -proot -e "CREATE DATABASE IF NOT EXISTS wp_extend_tests CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; GRANT ALL PRIVILEGES ON wp_extend_tests.* TO 'db'@'%'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || {
        echo "[pre-push] Could not prepare the test database — skipping the PHPUnit suite (not blocking the push)."
        exit 0
    }

echo "[pre-push] Running PHPUnit (tests/)..."
if ! ddev exec bash -c "cd wp-content/plugins/wp-extend && WP_CORE_DIR=/var/www/html WP_TESTS_DB_HOST=db tests/vendor/bin/phpunit -c phpunit.xml.dist"; then
    echo "[pre-push] Aborting push: the PHPUnit suite failed. Fix the failing test(s) above, or run with --no-verify if you are certain this push should bypass tests."
    exit 1
fi

echo "[pre-push] Running the self-test suite (includes/classes/ewp-self-test/manifest.json) against the test database..."
if ! ddev exec bash -c "cd wp-content/plugins/wp-extend && WP_CORE_DIR=/var/www/html WP_TESTS_DB_HOST=db php tests/self-test-runner.php"; then
    echo "[pre-push] Aborting push: a self-test case failed (every REST route / CLI command / ability in the manifest is exercised). See the checks above."
    exit 1
fi

echo "[pre-push] All tests passed."
exit 0
